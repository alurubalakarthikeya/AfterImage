{
  "name": "afterimage",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "AfterImage — a local-first desktop application for your personal digital archive.",
  "repository": {
    "type": "git",
    "url": "https://github.com/alurubalakarthikeya/AfterImage.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:search": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-search.mjs",
    "release": "node scripts/release.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "icons:web": "node scripts/generate-web-icons.mjs",
    "service:venv": "node scripts/service.mjs venv",
    "service:install": "node scripts/service.mjs install",
    "service:install:full": "node scripts/service.mjs install --full",
    "service:dev": "node scripts/service.mjs dev",
    "service:build": "node scripts/service.mjs build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-notification": "^2.3.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
